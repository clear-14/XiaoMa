# ============================================
# 小码 Xiaoma 统一环境变量配置
# 用法：复制本文件为 .env，按需修改后供 Docker Compose 使用。
# 本地开发无需 .env，代码内默认值与下列值一致。
# .env 包含访问密码等敏感信息，严禁提交到 Git。
# ============================================

# ---- 应用信息 ----
APP_NAME=xiaoma-backend
APP_VERSION=1.4.1

# ---- 访问范围与端口 ----
# BIND_ADDRESS 是宿主机端口绑定地址：
#   127.0.0.1（默认）= 仅本机访问；
#   0.0.0.0         = 开放局域网/公网，必须同时设置访问密码与
#                     XIAOMA_ALLOW_REMOTE=true，否则后端拒绝启动。
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# ---- 访问密码（开放局域网/公网时必填）----
# 设置后浏览器需先输入密码登录，所有 API（健康检查/登录/登录状态除外）
# 都由后端中间件强制校验 Bearer 会话令牌，不依赖前端隐藏页面。
# 留空表示不启用访问密码，此时必须保持 BIND_ADDRESS=127.0.0.1。
# XIAOMA_ACCESS_PASSWORD=
# XIAOMA_ALLOW_REMOTE=false
# 登录会话有效期（秒），默认 86400（24 小时）；后端重启后会话失效。
# XIAOMA_ACCESS_TOKEN_TTL_SECONDS=86400

# ---- 数据库 ----
# SQLite 文件路径。本地开发默认生成在 backend/data/xiaoma.db；
# 容器内默认 /app/data/xiaoma.db（由命名卷持久化，勿改为容器临时目录）。
# DATABASE_URL=sqlite:///./data/xiaoma.db

# ---- 数据备份 ----
# 备份目录，默认与数据库同目录的 backups/（Docker 下位于数据卷内）。
# XIAOMA_BACKUP_DIR=/app/data/backups

# ---- 前端访问后端的 API 地址 ----
# Docker 部署无需设置：浏览器使用同源 /api/v1，由 Next.js 服务端代理到
# 后端容器。仅在前后端分离部署且需要浏览器直连后端时才修改。
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# ---- 跨域来源白名单（可选，逗号分隔）----
# 仅浏览器直连后端 API/SSE 时需要。本机 localhost / 127.0.0.1 任意端口
# 默认允许；通过局域网 IP 或自定义域名直连后端时在此追加来源。
# CORS_ALLOW_ORIGINS=http://192.168.1.5:3000,https://xiaoma.example

# ---- 主 Agent 执行超时（秒）----
# 单次 Agent 请求（含意图识别、子图与模型调用）的整体超时；默认 120 秒。
# 单个模型调用仍受模型配置中的 timeout 约束。超时后返回明确错误并保存失败消息。
# XIAOMA_AGENT_TIMEOUT_SECONDS=120

# ---- 模型 API Key 加密密钥（可选）----
# 模型配置中的 API Key 使用 Fernet 加密保存。未设置时后端首次启动会自动
# 生成 backend/data/.secret_key（Docker 下位于数据卷 /app/data，随备份保留）。
# 如需自行管理密钥，可填写任意口令字符串（由 SHA-256 派生）或 44 位 Fernet 密钥。
# 注意：更换密钥后，已保存的模型 API Key 将无法解密，需要在设置页重新填写。
# XIAOMA_SECRET_KEY=
